# Writes the "why this book" line. Without it, Booksrec still searches real catalogs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Google Books is steadier with a key, which helps newer titles.
GOOGLE_BOOKS_API_KEY=

# Optional cache of books Booksrec has already returned.
# Server only. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
